
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String         @id @default(uuid())
  firstName             String
  lastName              String
  email                 String         @unique
  password              String
  profilePicture        String?
  role                  Role           @default(USER)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  employee              Employee?
  leaveRequests         LeaveRequest[] @relation("EmployeeLeaveRequests")
  approvedLeaveRequests LeaveRequest[] @relation("ApproverLeaveRequests")
  invoices              Invoice[]      @relation("UserInvoices")
  payments              Payment[]      @relation("UserPayments")
}

enum Role {
  USER
  MANAGER
  FINANCE
  HR
  ADMIN
}

model Employee {
  id               String        @id @default(uuid())
  userId           String        @unique
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  personalId       String        @unique // CNP (Cod Numeric Personal)
  dateOfBirth      DateTime
  phoneNumber      String
  address          String
  city             String
  country          String        @default("Romania")
  position         String        // Job title/function
  department       String
  contractType     ContractType
  employmentDate   DateTime
  contractEndDate  DateTime?     // For fixed-term contracts
  salary           Float?        // Optional, sensitive data
  annualLeaveDays  Int           @default(21) // Legal minimum in Romania
  remainingLeave   Int           @default(21)
  managerId        String?
  manager          Employee?     @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates     Employee[]    @relation("ManagerSubordinates")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

enum ContractType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  FIXED_TERM
  TEMPORARY
}

model LeaveRequest {
  id          String            @id @default(uuid())
  employeeId  String
  employee    User              @relation("EmployeeLeaveRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType
  startDate   DateTime
  endDate     DateTime
  days        Int               // Number of days requested
  reason      String?
  status      LeaveStatus       @default(PENDING)
  approverId  String?
  approver    User?             @relation("ApproverLeaveRequests", fields: [approverId], references: [id])
  comments    String?           // Comments from approver
  approvedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

enum LeaveType {
  ANNUAL        // Concediu de odihnă
  MEDICAL       // Concediu medical
  UNPAID        // Concediu fără plată
  MATERNITY     // Concediu de maternitate
  PATERNITY     // Concediu de paternitate
  STUDY         // Concediu de studii
  SPECIAL       // Evenimente deosebite (căsătorie, deces, etc.)
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ==========================================
// Finance Module
// ==========================================

enum PartnerType {
  CLIENT
  SUPPLIER
  BOTH
}

enum InvoiceType {
  FISCAL
  PROFORMA
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  OTHER
}

model Partner {
  id                 String      @id @default(uuid())
  name               String
  cui                String      @unique // CUI / CIF
  regCom             String?     // J-number (Registrul Comertului)
  address            String
  city               String
  country            String      @default("Romania")
  email              String?
  phone              String?
  contactPerson      String?
  partnerType        PartnerType
  bankName           String?
  bankAccount        String?     // IBAN
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  invoicesAsClient   Invoice[]   @relation("ClientInvoices")
  invoicesAsSupplier Invoice[]   @relation("SupplierInvoices")
}

model Invoice {
  id              String        @id @default(uuid())
  series          String        @default("CORP")
  number          Int           @default(autoincrement())
  invoiceType     InvoiceType
  status          InvoiceStatus @default(DRAFT)
  partnerId       String
  partner         Partner       @relation("ClientInvoices", fields: [partnerId], references: [id])
  supplierId      String?
  supplier        Partner?      @relation("SupplierInvoices", fields: [supplierId], references: [id])
  isClientInvoice Boolean       @default(true) // true = we invoice them, false = they invoice us
  issueDate       DateTime      @default(now())
  dueDate         DateTime
  deliveryDate    DateTime?
  subtotal        Float         @default(0)
  vatTotal        Float         @default(0)
  total           Float         @default(0)
  paidAmount      Float         @default(0)
  currency        String        @default("RON")
  notes           String?
  createdById     String
  createdBy       User          @relation("UserInvoices", fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           InvoiceItem[]
  payments        Payment[]

  @@unique([series, number])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  unit        String  @default("buc") // buc, kg, ore, etc.
  unitPrice   Float
  vatRate     Float   @default(19) // percentage
  amount      Float   // quantity * unitPrice
  vatAmount   Float   // amount * vatRate / 100
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount        Float
  paymentDate   DateTime
  paymentMethod PaymentMethod
  reference     String?       // bank ref / receipt number
  notes         String?
  createdById   String
  createdBy     User          @relation("UserPayments", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
}