generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String         @id @default(uuid())
  email                 String         @unique
  password              String
  role                  Role           @default(USER)
  createdAt             DateTime       @default(now())
  firstName             String
  lastName              String
  updatedAt             DateTime       @updatedAt
  profilePicture        String?
  employee              Employee?
  invoices              Invoice[]      @relation("UserInvoices")
  approvedLeaveRequests LeaveRequest[] @relation("ApproverLeaveRequests")
  leaveRequests         LeaveRequest[] @relation("EmployeeLeaveRequests")
  payments              Payment[]      @relation("UserPayments")
  stockMovements        StockMovement[] @relation("UserStockMovements")
}

model Employee {
  id              String       @id @default(uuid())
  userId          String?      @unique
  firstName       String       @default("")
  lastName        String       @default("")
  personalId      String       @unique
  dateOfBirth     DateTime
  phoneNumber     String
  address         String
  city            String
  country         String       @default("Romania")
  position        String
  department      String
  contractType    ContractType
  employmentDate  DateTime
  contractEndDate DateTime?
  salary          Float?
  annualLeaveDays Int          @default(21)
  remainingLeave  Int          @default(21)
  managerId       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  manager         Employee?    @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates    Employee[]   @relation("ManagerSubordinates")
  user            User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LeaveRequest {
  id         String      @id @default(uuid())
  employeeId String
  leaveType  LeaveType
  startDate  DateTime
  endDate    DateTime
  days       Int
  reason     String?
  status     LeaveStatus @default(PENDING)
  approverId String?
  comments   String?
  approvedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  approver   User?       @relation("ApproverLeaveRequests", fields: [approverId], references: [id])
  employee   User        @relation("EmployeeLeaveRequests", fields: [employeeId], references: [id], onDelete: Cascade)
}

model Partner {
  id                 String      @id @default(uuid())
  name               String
  cui                String      @unique
  regCom             String?
  address            String
  city               String
  country            String      @default("Romania")
  email              String?
  phone              String?
  contactPerson      String?
  partnerType        PartnerType
  bankName           String?
  bankAccount        String?
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  invoicesAsClient   Invoice[]   @relation("ClientInvoices")
  invoicesAsSupplier Invoice[]   @relation("SupplierInvoices")
}

model Invoice {
  id              String        @id @default(uuid())
  series          String        @default("CORP")
  number          Int           @default(autoincrement())
  invoiceType     InvoiceType
  status          InvoiceStatus @default(DRAFT)
  partnerId       String
  supplierId      String?
  isClientInvoice Boolean       @default(true)
  issueDate       DateTime      @default(now())
  dueDate         DateTime
  deliveryDate    DateTime?
  subtotal        Float         @default(0)
  vatTotal        Float         @default(0)
  total           Float         @default(0)
  paidAmount      Float         @default(0)
  currency        String        @default("RON")
  notes           String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdBy       User          @relation("UserInvoices", fields: [createdById], references: [id])
  partner         Partner       @relation("ClientInvoices", fields: [partnerId], references: [id])
  supplier        Partner?      @relation("SupplierInvoices", fields: [supplierId], references: [id])
  items           InvoiceItem[]
  payments        Payment[]

  @@unique([series, number])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Float
  unit        String  @default("buc")
  unitPrice   Float
  vatRate     Float   @default(19)
  amount      Float
  vatAmount   Float
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String
  amount        Float
  paymentDate   DateTime
  paymentMethod PaymentMethod
  reference     String?
  notes         String?
  createdById   String
  createdAt     DateTime      @default(now())
  createdBy     User          @relation("UserPayments", fields: [createdById], references: [id])
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Warehouse {
  id        String         @id @default(uuid())
  name      String
  code      String         @unique
  address   String?
  city      String?
  country   String         @default("Romania")
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  products  ProductStock[]
  movements StockMovement[]
}

model Product {
  id           String         @id @default(uuid())
  sku          String         @unique
  name         String
  description  String?
  unit         String         @default("pcs")
  category     String?
  minimumStock Float          @default(0)
  currentStock Float          @default(0)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  warehouses   ProductStock[]
  movements    StockMovement[]
}

model ProductStock {
  id          String    @id @default(uuid())
  productId   String
  warehouseId String
  quantity    Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
}

model StockMovement {
  id          String            @id @default(uuid())
  productId   String
  warehouseId String
  type        StockMovementType
  quantity    Float
  unitCost    Float?
  reference   String?
  notes       String?
  performedAt DateTime          @default(now())
  createdById String
  createdAt   DateTime          @default(now())
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdBy   User              @relation("UserStockMovements", fields: [createdById], references: [id])
}

enum Role {
  USER
  MANAGER
  FINANCE
  ADMIN
  HR
}

enum ContractType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  FIXED_TERM
  TEMPORARY
}

enum LeaveType {
  ANNUAL
  MEDICAL
  UNPAID
  MATERNITY
  PATERNITY
  STUDY
  SPECIAL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PartnerType {
  CLIENT
  SUPPLIER
  BOTH
}

enum InvoiceType {
  FISCAL
  PROFORMA
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  OTHER
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

model Vehicle {
  id            String           @id @default(uuid())
  plateNumber   String           @unique
  chassisNumber String           @unique
  brand         String
  model         String
  year          Int
  fuelType      FuelType
  status        VehicleStatus    @default(ACTIVE)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  documents     VehicleDocument[]
  mileageLogs   MileageLog[]
  leases        VehicleLease[]
  expenses      VehicleExpense[]
}

model VehicleDocument {
  id         String       @id @default(uuid())
  vehicleId  String
  vehicle    Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type       DocumentType
  expiryDate DateTime
  issuedDate DateTime?
  provider   String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model MileageLog {
  id        String   @id @default(uuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date      DateTime
  odometer  Int
  notes     String?
  createdAt DateTime @default(now())
}

model VehicleLease {
  id          String   @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  provider    String
  startDate   DateTime
  endDate     DateTime
  monthlyRate Float
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VehicleExpense {
  id          String      @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type        ExpenseType
  amount      Float
  date        DateTime
  description String?
  createdAt   DateTime    @default(now())
}

enum FuelType {
  DIESEL
  PETROL
  ELECTRIC
  HYBRID
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum DocumentType {
  ITP
  RCA
  CASCO
  ROVINIETA
}

enum ExpenseType {
  FUEL
  REPAIR
  OTHER
}
