generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String         @id @default(uuid())
  email                 String         @unique
  password              String
  role                  Role           @default(USER)
  createdAt             DateTime       @default(now())
  firstName             String
  lastName              String
  updatedAt             DateTime       @updatedAt
  profilePicture        String?
  employee              Employee?
  uploadedEmployeeDocuments EmployeeDocument[] @relation("EmployeeDocumentUploader")
  createdPayrollPeriods PayrollPeriod[] @relation("PayrollPeriodCreator")
  approvedPayrollPeriods PayrollPeriod[] @relation("PayrollPeriodApprover")
  paidPayrollPeriods PayrollPeriod[] @relation("PayrollPeriodPayer")
  invoices              Invoice[]      @relation("UserInvoices")
  approvedLeaveRequests LeaveRequest[] @relation("ApproverLeaveRequests")
  leaveRequests         LeaveRequest[] @relation("EmployeeLeaveRequests")
  payments              Payment[]      @relation("UserPayments")
  stockMovements        StockMovement[] @relation("UserStockMovements")
  projects              Project[]            @relation("UserProjects")
  projectMemberships    ProjectMember[]      @relation("UserProjectMemberships")
  assignedProjectTasks  ProjectTask[]        @relation("UserAssignedTasks")
  createdProjectTasks   ProjectTask[]        @relation("UserCreatedTasks")
  projectFeedPosts      ProjectFeedEntry[]   @relation("UserProjectPosts")
  notifications         Notification[]       @relation("UserNotifications")
  projectTaskComments   ProjectTaskComment[] @relation("ProjectTaskCommentAuthor")
  purchaseOrders        PurchaseOrder[]        @relation("UserPurchaseOrders")
  purchaseReceipts      PurchaseOrderReceipt[] @relation("UserPurchaseReceipts")
}

model Employee {
  id              String       @id @default(uuid())
  userId          String?      @unique
  firstName       String       @default("")
  lastName        String       @default("")
  personalId      String       @unique
  dateOfBirth     DateTime
  phoneNumber     String
  address         String
  city            String
  country         String       @default("Romania")
  position        String
  department      Department
  contractType    ContractType
  isContractor    Boolean      @default(false)
  employmentDate  DateTime
  contractEndDate DateTime?
  salary          Float
  annualLeaveDays Int          @default(21)
  remainingLeave  Int          @default(21)
  managerId       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  manager         Employee?    @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates    Employee[]   @relation("ManagerSubordinates")
  user            User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents       EmployeeDocument[]
  payrollLines    PayrollLine[]
}

model PayrollPeriod {
  id           String        @id @default(uuid())
  year         Int
  month        Int
  status       PayrollStatus @default(DRAFT)
  currency     String        @default("EUR")
  notes        String?
  createdById  String
  approvedById String?
  approvedAt   DateTime?
  paidById     String?
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdBy    User          @relation("PayrollPeriodCreator", fields: [createdById], references: [id])
  approvedBy   User?         @relation("PayrollPeriodApprover", fields: [approvedById], references: [id])
  paidBy       User?         @relation("PayrollPeriodPayer", fields: [paidById], references: [id])
  lines        PayrollLine[]

  @@unique([year, month])
  @@index([status, year, month])
}

model PayrollLine {
  id              String        @id @default(uuid())
  periodId        String
  employeeId      String
  grossSalary     Float         @map("baseSalary")
  bonus           Float         @default(0)
  manualDeductions Float        @default(0) @map("deductions")
  unpaidLeaveDays Int           @default(0)
  unpaidLeaveDeduction Float    @default(0)
  taxableGross    Float         @default(0)
  casRate         Float         @default(25)
  casAmount       Float         @default(0)
  cassRate        Float         @default(10)
  cassAmount      Float         @default(0)
  incomeTaxRate   Float         @default(10)
  incomeTaxAmount Float         @default(0)
  camRate         Float         @default(2.25)
  camAmount       Float         @default(0)
  employerTotalCost Float       @default(0)
  taxRuleVersion  String        @default("RO_2026_STANDARD")
  netAmount       Float
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  period          PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee        Employee      @relation(fields: [employeeId], references: [id])

  @@unique([periodId, employeeId])
  @@index([employeeId])
}

model EmployeeDocument {
  id           String               @id @default(uuid())
  employeeId   String
  type         EmployeeDocumentType
  title        String
  fileName     String
  fileUrl      String
  mimeType     String
  size         Int
  expiryDate   DateTime?
  notes        String?
  uploadedById String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  employee     Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedBy   User                 @relation("EmployeeDocumentUploader", fields: [uploadedById], references: [id])

  @@index([employeeId, createdAt])
  @@index([type])
}

model LeaveRequest {
  id         String      @id @default(uuid())
  employeeId String
  leaveType  LeaveType
  startDate  DateTime
  endDate    DateTime
  days       Int
  reason     String?
  status     LeaveStatus @default(PENDING)
  approverId String?
  comments   String?
  approvedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  approver   User?       @relation("ApproverLeaveRequests", fields: [approverId], references: [id])
  employee   User        @relation("EmployeeLeaveRequests", fields: [employeeId], references: [id], onDelete: Cascade)
}

model Partner {
  id                 String      @id @default(uuid())
  name               String
  cui                String      @unique
  regCom             String?
  address            String
  city               String
  country            String      @default("Romania")
  email              String?
  phone              String?
  contactPerson      String?
  partnerType        PartnerType
  bankName           String?
  bankAccount        String?
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  invoicesAsClient   Invoice[]   @relation("ClientInvoices")
  invoicesAsSupplier Invoice[]   @relation("SupplierInvoices")
  projects           Project[]
  purchaseOrders     PurchaseOrder[] @relation("SupplierPurchaseOrders")
}

model Invoice {
  id              String        @id @default(uuid())
  series          String        @default("CORP")
  number          Int           @default(autoincrement())
  invoiceType     InvoiceType
  status          InvoiceStatus @default(DRAFT)
  partnerId       String
  supplierId      String?
  isClientInvoice Boolean       @default(true)
  issueDate       DateTime      @default(now())
  dueDate         DateTime
  deliveryDate    DateTime?
  subtotal        Float         @default(0)
  vatTotal        Float         @default(0)
  total           Float         @default(0)
  paidAmount      Float         @default(0)
  currency        String        @default("RON")
  notes           String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdBy       User          @relation("UserInvoices", fields: [createdById], references: [id])
  partner         Partner       @relation("ClientInvoices", fields: [partnerId], references: [id])
  supplier        Partner?      @relation("SupplierInvoices", fields: [supplierId], references: [id])
  items           InvoiceItem[]
  payments        Payment[]
  projectId       String?
  project         Project?      @relation(fields: [projectId], references: [id])

  @@unique([series, number])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Float
  unit        String  @default("buc")
  unitPrice   Float
  vatRate     Float   @default(19)
  amount      Float
  vatAmount   Float
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String
  amount        Float
  paymentDate   DateTime
  paymentMethod PaymentMethod
  reference     String?
  notes         String?
  createdById   String
  createdAt     DateTime      @default(now())
  createdBy     User          @relation("UserPayments", fields: [createdById], references: [id])
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Warehouse {
  id               String              @id @default(uuid())
  name             String
  code             String              @unique
  address          String?
  city             String?
  country          String              @default("Romania")
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  products         ProductStock[]
  movements        StockMovement[]
  projectMaterials ProjectMaterial[]   @relation("WarehouseProjectMaterials")
  purchaseOrders   PurchaseOrder[]
}

model Product {
  id               String              @id @default(uuid())
  sku              String              @unique
  name             String
  description      String?
  unit             String              @default("pcs")
  category         String?
  minimumStock     Float               @default(0)
  currentStock     Float               @default(0)
  unitPrice        Float               @default(0)
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  warehouses       ProductStock[]
  movements        StockMovement[]
  projectMaterials ProjectMaterial[]   @relation("ProductProjectMaterials")
  purchaseOrderLines PurchaseOrderLine[] @relation("ProductPurchaseLines")
}

model ProductStock {
  id           String    @id @default(uuid())
  productId    String
  warehouseId  String
  quantity     Float     @default(0)
  reservedQty  Float     @default(0)
  defectiveQty Float     @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
}

model StockMovement {
  id                String            @id @default(uuid())
  productId         String
  warehouseId       String
  type              StockMovementType
  quantity          Float
  unitCost          Float?
  reference         String?
  notes             String?
  performedAt       DateTime          @default(now())
  createdById       String
  createdAt         DateTime          @default(now())
  projectId         String?
  projectMaterialId String?
  purchaseReceiptLineId String?
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse         Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdBy         User              @relation("UserStockMovements", fields: [createdById], references: [id])
  project           Project?          @relation(fields: [projectId], references: [id])
  projectMaterial   ProjectMaterial?  @relation("ProjectMaterialMovements", fields: [projectMaterialId], references: [id])
  purchaseReceiptLine PurchaseOrderReceiptLine? @relation("ReceiptLineMovements", fields: [purchaseReceiptLineId], references: [id])
}

enum Role {
  USER
  ADMIN
}

enum Department {
  HR
  FINANCE
  WAREHOUSE
  FLEET
  MANAGEMENT
  IT
}

enum ContractType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  FIXED_TERM
  TEMPORARY
}

enum EmployeeDocumentType {
  ID_CARD
  CONTRACT
  MEDICAL_CERTIFICATE
  DIPLOMA
  TRAINING
  OTHER
}

enum LeaveType {
  ANNUAL
  MEDICAL
  UNPAID
  MATERNITY
  PATERNITY
  STUDY
  SPECIAL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PartnerType {
  CLIENT
  SUPPLIER
  BOTH
}

enum InvoiceType {
  FISCAL
  PROFORMA
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  OTHER
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  DEFECT
  SCRAP
}

model Vehicle {
  id                 String             @id @default(uuid())
  plateNumber        String             @unique
  chassisNumber      String             @unique
  brand              String
  model              String
  year               Int
  fuelType           FuelType
  status             VehicleStatus      @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  documents          VehicleDocument[]
  mileageLogs        MileageLog[]
  leases             VehicleLease[]
  expenses           VehicleExpense[]
  projectAssignments ProjectVehicle[]   @relation("VehicleProjectAssignments")
}

model VehicleDocument {
  id         String       @id @default(uuid())
  vehicleId  String
  vehicle    Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type       DocumentType
  expiryDate DateTime
  issuedDate DateTime?
  provider   String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model MileageLog {
  id        String   @id @default(uuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date      DateTime
  odometer  Int
  notes     String?
  createdAt DateTime @default(now())
}

model VehicleLease {
  id          String   @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  provider    String
  startDate   DateTime
  endDate     DateTime
  monthlyRate Float
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VehicleExpense {
  id          String      @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type        ExpenseType
  amount      Float
  date        DateTime
  description String?
  createdAt   DateTime    @default(now())
  projectId   String?
  project     Project?    @relation(fields: [projectId], references: [id])
}

enum FuelType {
  DIESEL
  PETROL
  ELECTRIC
  HYBRID
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum DocumentType {
  ITP
  RCA
  CASCO
  ROVINIETA
}

enum ExpenseType {
  FUEL
  REPAIR
  OTHER
}

model CompanySettings {
  id                    String   @id @default("singleton")
  companyName           String   @default("")
  cui                   String   @default("")
  regCom                String   @default("")
  address               String   @default("")
  city                  String   @default("")
  country               String   @default("Romania")
  email                 String   @default("")
  phone                 String   @default("")
  bankName              String   @default("")
  bankAccount           String   @default("")
  defaultInvoiceSeries  String   @default("CORP")
  defaultCurrency       String   @default("EUR")
  defaultVatRate        Float    @default(19)
  paymentTermsDays      Int      @default(30)
  defaultAnnualLeaveDays Int     @default(21)
  defaultCountry        String   @default("Romania")
  fleetExpiryThresholdItp       Int @default(30)
  fleetExpiryThresholdRca       Int @default(30)
  fleetExpiryThresholdCasco     Int @default(30)
  fleetExpiryThresholdRovinieta Int @default(7)
  payrollTaxCasRate             Float @default(25)
  payrollTaxCassRate            Float @default(10)
  payrollTaxIncomeRate          Float @default(10)
  payrollTaxCamRate             Float @default(2.25)
  payrollPersonalDeduction      Float @default(0)
  payrollTaxRuleVersion         String @default("RO_2026_STANDARD")
  updatedAt             DateTime @updatedAt
}

model Project {
  id               String              @id @default(uuid())
  code             String              @unique
  name             String
  description      String?
  partnerId        String
  partner          Partner             @relation(fields: [partnerId], references: [id])
  status           ProjectStatus       @default(PLANNING)
  budget           Float               @default(0)
  currency         String              @default("RON")
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  notes            String?
  createdById      String
  createdBy        User                @relation("UserProjects", fields: [createdById], references: [id])
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  members          ProjectMember[]
  materials        ProjectMaterial[]
  vehicles         ProjectVehicle[]
  tasks            ProjectTask[]
  feed             ProjectFeedEntry[]
  invoices         Invoice[]
  stockMovements   StockMovement[]
  vehicleExpenses  VehicleExpense[]
}

model ProjectMember {
  id        String            @id @default(uuid())
  projectId String
  userId    String
  role      ProjectMemberRole @default(MEMBER)
  joinedAt  DateTime          @default(now())
  leftAt    DateTime?
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User              @relation("UserProjectMemberships", fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model ProjectMaterial {
  id           String                 @id @default(uuid())
  projectId    String
  productId    String
  warehouseId  String
  requestedQty Float                  @default(0)
  reservedQty  Float                  @default(0)
  issuedQty    Float                  @default(0)
  unitCost     Float                  @default(0)
  status       ProjectMaterialStatus  @default(REQUESTED)
  notes        String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product      Product                @relation("ProductProjectMaterials", fields: [productId], references: [id])
  warehouse    Warehouse              @relation("WarehouseProjectMaterials", fields: [warehouseId], references: [id])
  movements    StockMovement[]        @relation("ProjectMaterialMovements")
}

model ProjectVehicle {
  id        String    @id @default(uuid())
  projectId String
  vehicleId String
  startDate DateTime
  endDate   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vehicle   Vehicle   @relation("VehicleProjectAssignments", fields: [vehicleId], references: [id])
}

model ProjectTask {
  id          String              @id @default(uuid())
  projectId   String
  title       String
  description String?
  assigneeId  String?
  status      ProjectTaskStatus   @default(TODO)
  priority    ProjectTaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?               @relation("UserAssignedTasks", fields: [assigneeId], references: [id])
  createdBy   User                @relation("UserCreatedTasks", fields: [createdById], references: [id])
  comments    ProjectTaskComment[]
}

model ProjectTaskComment {
  id        String   @id @default(uuid())
  taskId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User        @relation("ProjectTaskCommentAuthor", fields: [authorId], references: [id])

  @@index([taskId, createdAt])
}

model ProjectFeedEntry {
  id             String          @id @default(uuid())
  projectId      String
  kind           ProjectFeedKind
  authorId       String?
  content        String
  attachmentUrl  String?
  attachmentName String?
  metadata       Json?
  createdAt      DateTime        @default(now())
  deletedAt      DateTime?
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author         User?           @relation("UserProjectPosts", fields: [authorId], references: [id])
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectMemberRole {
  PROJECT_MANAGER
  MEMBER
}

enum ProjectMaterialStatus {
  REQUESTED
  RESERVED
  PARTIALLY_ISSUED
  FULLY_ISSUED
  CANCELLED
}

enum ProjectTaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum ProjectTaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ProjectFeedKind {
  AUTO
  POST
}

model Notification {
  id          String                   @id @default(uuid())
  recipientId String
  recipient   User                     @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  body        String?
  linkPath    String?
  entityType  NotificationEntityType?
  entityId    String?
  isRead      Boolean                  @default(false)
  readAt      DateTime?
  createdAt   DateTime                 @default(now())

  @@index([recipientId, isRead, createdAt])
  @@index([recipientId, entityType, entityId])
}

enum NotificationType {
  LEAVE_REQUEST_SUBMITTED
  LEAVE_REQUEST_APPROVED
  LEAVE_REQUEST_REJECTED
  PROJECT_TASK_ASSIGNED
  FLEET_DOCUMENT_EXPIRING
  EMPLOYEE_DOCUMENT_EXPIRING
  STOCK_BELOW_MINIMUM
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

enum NotificationEntityType {
  LEAVE_REQUEST
  PROJECT_TASK
  VEHICLE_DOCUMENT
  EMPLOYEE_DOCUMENT
  PRODUCT
}

model PurchaseOrder {
  id           String                 @id @default(uuid())
  series       String                 @default("PO")
  number       Int                    @default(autoincrement())
  supplierId   String
  warehouseId  String
  status       PurchaseOrderStatus    @default(DRAFT)
  orderDate    DateTime               @default(now())
  expectedDate DateTime?
  currency     String                 @default("RON")
  subtotal     Float                  @default(0)
  notes        String?
  cancelledAt  DateTime?
  cancelReason String?
  createdById  String
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  supplier     Partner                @relation("SupplierPurchaseOrders", fields: [supplierId], references: [id])
  warehouse    Warehouse              @relation(fields: [warehouseId], references: [id])
  createdBy    User                   @relation("UserPurchaseOrders", fields: [createdById], references: [id])
  lines        PurchaseOrderLine[]
  receipts     PurchaseOrderReceipt[]

  @@unique([series, number])
  @@index([status, expectedDate])
}

model PurchaseOrderLine {
  id           String                     @id @default(uuid())
  orderId      String
  productId    String
  qtyOrdered   Float
  qtyReceived  Float                      @default(0)
  unitCost     Float
  notes        String?
  order        PurchaseOrder              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product                    @relation("ProductPurchaseLines", fields: [productId], references: [id])
  receiptLines PurchaseOrderReceiptLine[]

  @@index([productId])
}

model PurchaseOrderReceipt {
  id           String                     @id @default(uuid())
  orderId      String
  nirSeries    String                     @default("NIR")
  nirNumber    Int                        @default(autoincrement())
  receivedDate DateTime                   @default(now())
  notes        String?
  createdById  String
  createdAt    DateTime                   @default(now())
  order        PurchaseOrder              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy    User                       @relation("UserPurchaseReceipts", fields: [createdById], references: [id])
  lines        PurchaseOrderReceiptLine[]

  @@unique([nirSeries, nirNumber])
}

model PurchaseOrderReceiptLine {
  id          String               @id @default(uuid())
  receiptId   String
  orderLineId String
  qtyReceived Float
  receipt     PurchaseOrderReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderLine   PurchaseOrderLine    @relation(fields: [orderLineId], references: [id])
  movements   StockMovement[]      @relation("ReceiptLineMovements")
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CANCELLED
}
